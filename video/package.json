{
  "name": "klay-video",
  "private": true,
  "description": "Klay's onboarding film, made in code with Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Onboarding out/klay-onboarding.mp4",
    "logo": "remotion render src/index.ts Logo out/klay-logo.mp4",
    "voice": "node scripts/voice.mjs",
    "voice:scratch": "node scripts/voice.mjs --scratch",
    "pictures": "node scripts/pictures.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.543",
    "@remotion/google-fonts": "^4.0.543",
    "@types/react": "^19.2.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "^4.0.543",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
