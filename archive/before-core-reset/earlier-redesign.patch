+test("Plan preserves positions across multiple pauses, reordering and resuming", () => {
+  let s = store.resetToDefault();
+  const original = [...ids(s)];
+  s = store.pauseWorkout(s, original[0]);
+  s = store.pauseWorkout(s, original[1]);
