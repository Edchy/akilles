+  assert.deepEqual([...ids(s)], expected);
+});
+
+test("a save from before Plan ordering reconstructs paused workouts in place", () => {
+  let s = store.resetToDefault();
+  const original = [...ids(s)];
+  s = store.pauseWorkout(s, original[0]);
