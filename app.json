{
  "expo": {
    "name": "Akilles",
    "slug": "akilles",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "akilles",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af661e39-36c8-42f1-b65d-8a421d220a92"
      }
    },
    "owner": "edch",
    "updates": {
      "url": "https://u.expo.dev/af661e39-36c8-42f1-b65d-8a421d220a92"
    }
  }
}
