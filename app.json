{
  "expo": {
    "name": "Klay",
    "slug": "klay",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "klay",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCFCFA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FCFCFA",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0B0B0B"
          }
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0aa84b42-bebb-4208-9e13-500269cb5593"
      }
    },
    "owner": "edch",
    "updates": {
      "url": "https://u.expo.dev/0aa84b42-bebb-4208-9e13-500269cb5593"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
